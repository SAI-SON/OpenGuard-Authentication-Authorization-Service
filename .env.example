# Environment Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to source control.

# Auth0 / OIDC Provider Configuration
# The domain of your Auth0 tenant (e.g., your-tenant.us.auth0.com)
AUTH0_DOMAIN=your-tenant.us.auth0.com

# The unique identifier (audience) of your Auth0 API
AUTH0_API_AUDIENCE=https://your-api-identifier

# The issuer URL for JWT validation (usually https://<AUTH0_DOMAIN>/)
AUTH0_ISSUER=https://your-tenant.us.auth0.com/

# Application Configuration
PORT=3000
NODE_ENV=development

# SQLite Database Path (relative to project root, or absolute)
DATABASE_PATH=./data/permissions.db
