# Node.js
node_modules/
dist/

# Environment files - never commit secrets
.env
.env.local
.env.production

# Database files - never commit the actual database
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Logs
logs/
*.log
npm-debug.log*

# OS generated files
.DS_Store
Thumbs.db

# Editor files
.vscode/settings.json
.idea/
*.swp
*.swo

# TypeScript build info
*.tsbuildinfo
