{
  "name": "open-fabric-auth-service",
  "version": "1.0.0",
  "description": "OAuth2 JWT validation and fine-grained permission authorization API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx --env-file=.env.local src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:seed": "tsx scripts/seed-database.ts"
  },
  "keywords": [
    "auth",
    "authorization",
    "oauth2",
    "jwt",
    "permissions"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "express-oauth2-jwt-bearer": "^1.11.0",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jose": "^5.10.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.7.1",
    "typescript": "^5.4.2",
    "vitest": "^1.4.0"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
